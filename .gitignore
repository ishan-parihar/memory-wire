target/
_audit/
.env
*.log
# eval/data/ is dataset scratch. The 264 MB LongMemEval-S dump stays untracked
# (fetch it with eval/download.sh); only the two small vendored coding-life
# fixtures are tracked, so `cargo run --release --example coding_life` works from
# a clean clone with no manual step. A negation cannot re-include a file through
# an ignored *directory*, so ignore the entries rather than the directory itself.
eval/data/*
!eval/data/sessions.json
!eval/data/queries.json
eval/results.json

# Live-bank run output. The pmv2 run wrote memory rows verbatim, and one of
# them held a pasted bot token. Add a directory here before its first run.
eval/omnimevaleval/memory-wire-mw_pmv2_dated/

# release assets built by scripts/build-release.sh
/dist

# Python bytecode from importing eval harnesses
__pycache__/

# genome runtime state (locks, temp files, recon tokens, read marks)
*.genome-lock
*.genome-tmp
.genome/
