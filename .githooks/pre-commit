#!/usr/bin/env bash
# Tracked so every clone gets the gate. Enable once per clone:
#   git config core.hooksPath .githooks
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
"$root/scripts/secret-scan.sh" --selftest
"$root/scripts/secret-scan.sh" --staged
"$root/scripts/secret-scan.sh" --remotes

# The plugin doors have no compiler and no type system: `trust_gate_test.sh` is
# the only executable check that an untrusted row cannot reach a model's system
# prompt through the two TypeScript doors, and it was wired to nothing until
# 2026-11-19. Both bugs it now catches were found by hand (CONSISTENCY §53/§58),
# which is the argument for running it here rather than trusting a human to
# remember. Guarded, because a clone without node must still be able to commit;
# it says so instead of skipping silently.
if command -v node > /dev/null 2>&1; then
  "$root/plugin/integrations/trust_gate_test.sh"
else
  echo "pre-commit: node not found, skipping the plugin door tests" >&2
fi

# AGENTS.md §3 is the map a fresh agent reads before touching anything, so a
# stale table is believed rather than ignored. It claimed "22 modules / 24.8k
# lines" against a real 32 / 35,373 for months and nothing checked, so this
# compares the table's module set and per-module counts to the tree. It cannot
# grade a role line's prose; that is still a human's job.
"$root/scripts/module_table_check.sh"

# And the other counts -- the ones written in prose rather than in a table.
# module_table_check grades one table; this grades every "N tools" and "N hosts"
# sentence, which is where they actually drift. Eleven instances are recorded in
# the script header; the eleventh was found while writing the plan that added
# this line, which is the argument for it.
"$root/scripts/count_claim_check.sh"

# And the citations. A `file:line` that NAMES the function it claims is there, and
# points somewhere else. The defect: OPEN_HOOK_RECALL_RELEVANCE.md cited
# `src/api.rs:1903` for `recall_should_score_with_the_fused_rrf_value`, which is
# at 3132 -- and was at 2168 even at the commit that document pins itself to. It
# was never right, which is different from a citation drifting as a file grows.
# Mutation battery 5/5 in the script header.
"$root/scripts/citation_name_check.sh"

# core.hooksPath replaces .git/hooks, which install-docs-gate writes to. Keep
# running that gate so enabling this hook does not silently disable it.
managed="$(git rev-parse --git-common-dir)/hooks/pre-commit"
if [ -x "$managed" ]; then
  exec "$managed"
fi
