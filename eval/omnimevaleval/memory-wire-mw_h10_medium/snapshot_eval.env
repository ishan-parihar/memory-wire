# memory-wire adapter env for OmniMemEval (used with --env)
# The LLM clients are the framework's own OpenAI-compatible clients; both point
# at the local aroute shim (eval/llm_shim.py), which forwards to the free-tier
# small-stack — the same instrument every judged run in this repo used.
ANSWER_API_KEY=***
ANSWER_BASE_URL=http://127.0.0.1:20199/v1
ANSWER_MODEL=small-stack
EVAL_API_KEY=***
EVAL_BASE_URL=http://127.0.0.1:20199/v1
EVAL_MODEL=small-stack
ANSWER_TIMEOUT=300
EVAL_TIMEOUT=300
LLM_MAX_RETRIES=3

# memory-wire adapter knobs (see scripts/client_factory/memory_wire_client.py)
MEMORY_WIRE_URL=http://127.0.0.1:8899
MEMORY_WIRE_TIMEOUT=60
